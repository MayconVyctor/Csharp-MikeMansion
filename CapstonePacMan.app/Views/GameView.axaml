<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CapstonePacMan.app.ViewModels"
    x:DataType="vm:GameViewModel"
    x:Class="CapstonePacMan.app.Views.GameView"
     Focusable="True">

    <Canvas>
        <Image
            Width="800"
            Height="800"
            Source="/Assets/background.png"/>

        <Image
            Width="20"
            Height="20"
            Source="{Binding Game.PacMan.ImagePath, Converter={StaticResource PathToBitmap}}"
            Canvas.Left="{Binding PacManScreenX}"
            Canvas.Top="{Binding PacManScreenY}" />

    </Canvas>

</UserControl>