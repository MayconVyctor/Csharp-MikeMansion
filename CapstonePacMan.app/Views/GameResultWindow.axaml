<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="CapstonePacMan.app.Views.GameResultWindow"
    Title="Fim de Jogo"
    Width="300"
    Height="180"
    WindowStartupLocation="CenterOwner"
    CanResize="False">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
        <TextBlock
            x:Name="ResultText"
            Text="FIM DE JOGO"
            FontSize="22"
            FontWeight="Bold"
            HorizontalAlignment="Center" />

        <TextBox
            x:Name="PlayerNameInput"
            PlaceholderText="Nome do jogador"
            Width="190" />

        <Button
            Content="Salvar e reiniciar"
            HorizontalAlignment="Center"
            Padding="20,8"
            Click="OnRestartClick" />
    </StackPanel>
</Window>