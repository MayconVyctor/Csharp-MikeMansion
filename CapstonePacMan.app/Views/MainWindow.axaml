<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CapstonePacMan.app.ViewModels"
        xmlns:views="using:CapstonePacMan.app.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="CapstonePacMan.app.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="Mike Mansion">

    <Grid>
        <Grid IsVisible="{Binding IsInMenu}" Background="Black" Width="800" Height="840">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="30">

                <TextBlock
                    Text="MIKE MANSION"
                    FontSize="64"
                    FontWeight="Bold"
                    Foreground="Yellow"
                    HorizontalAlignment="Center" />

                <StackPanel Spacing="15">
                    <Button
                        Width="220"
                        Content="Iniciar Jogo"
                        HorizontalAlignment="Center"
                        Command="{Binding StartGameCommand}"
                        Click="OnStartGameClick"/>

                    <ComboBox
                        Width="220"
                        ItemsSource="{Binding AvailableLevels}"
                        SelectedItem="{Binding SelectedLevel}"
                        PlaceholderText="Escolha o nivel" />

                    <ComboBox
                        Width="220"
                        ItemsSource="{Binding AvailableDifficulties}"
                        SelectedItem="{Binding SelectedDifficulty}"
                        PlaceholderText="Escolha a dificuldade" />

                    <Button
                        Width="220"
                        Content="Placar"
                        HorizontalAlignment="Center"
                        Click="OnScoreBoardClick"/>

                    <Button
                        Width="220"
                        Content="Sair"
                        HorizontalAlignment="Center"
                        Click="OnExitClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid IsVisible="{Binding !IsInMenu}">
            <ContentControl x:Name="GameContent" />
        </Grid>
    </Grid>

</Window>