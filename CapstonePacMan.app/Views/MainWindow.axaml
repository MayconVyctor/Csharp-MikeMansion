<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CapstonePacMan.app.ViewModels"
        xmlns:views="using:CapstonePacMan.app.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="CapstonePacMan.app.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="Mike Mansion">

    <Grid>
        <Grid IsVisible="{Binding IsInMenu}" Background="Black" Width="672" Height="1100">
            <Image
                Source="/Assets/AssetsMikeMansion/AssetTelaInicialMikeMansion/CapaMikeMansion.jpeg"
                Stretch="UniformToFill"
                Opacity="0.72" />

            <Rectangle
                Fill="#66000000"
                IsHitTestVisible="False" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="15"
                Width="240">

                <StackPanel Spacing="15">
                    <Button
                        Width="220"
                        Content="Iniciar Jogo"
                        HorizontalAlignment="Center"
                        Click="OnStartGameClick"/>

                    <ComboBox
                        Width="220"
                        ItemsSource="{Binding AvailableLevels}"
                        SelectedItem="{Binding SelectedLevel}"
                        PlaceholderText="Escolha o nivel" />

                    <ComboBox
                        Width="220"
                        ItemsSource="{Binding AvailableDifficulties}"
                        SelectedItem="{Binding SelectedDifficulty}"
                        PlaceholderText="Escolha a dificuldade" />

                    <Button
                        Width="220"
                        Content="Placar"
                        HorizontalAlignment="Center"
                        Click="OnScoreBoardClick"/>
                    <Button
                        Width="220"
                        Content="Mutar / Desmutar"
                        HorizontalAlignment="Center"
                        Click="OnToggleMuteClick"/>

                    <Button
                        Width="220"
                        Content="Sair"
                        HorizontalAlignment="Center"
                        Click="OnExitClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid IsVisible="{Binding !IsInMenu}">
            <ContentControl x:Name="GameContent" />
        </Grid>
    </Grid>

</Window>